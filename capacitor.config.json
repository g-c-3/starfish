{
  "appId": "com.dumpzone.app",
  "appName": "Dumpzone",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#488AFF",
      "sound": "notify_tone.wav"
    },
    "GoogleAuth": {
      "scopes": ["https://www.googleapis.com/auth/drive.file"],
      "grantOfflineAccess": false,
      "androidClientId": "REPLACE_WITH_ANDROID_OAUTH_CLIENT_ID.apps.googleusercontent.com"
    }
  }
}
