{
  "appId": "com.dumpzone.app",
  "appName": "Arkly",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorSQLite": {
      "androidIsEncryption": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#488AFF",
      "sound": "notify_tone.wav"
    },
    "PrivacyScreen": {
      "enable": false
    }
  }
}
